# Atende o botão "Gerar notícias agora" do painel (disparado por hooke-news-request.timer).
[Unit]
Description=Hooke - gerador de noticias (pedido do painel)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
ExecStart=/home/ec2-user/hooke-news-pipeline/deploy/run.sh --if-requested
TimeoutStartSec=45min
