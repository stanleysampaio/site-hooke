{
  "name": "hooke-news-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Gera as matérias do feed de notícias da Hooke (scraping + Gemini + imagem) e envia para o worker como pendentes.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
