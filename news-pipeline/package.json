    "check-sources": "node src/run.js --check-sources"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^18.0.8",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^28.1.0",
    "sharp": "^0.35.5"
  }
}
