# Copie para .env e preencha. Nunca faça commit do .env.

# Gemini: https://aistudio.google.com/apikey
# A geração de imagem normalmente exige faturamento ativo na conta Google (custo por imagem).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Vazio = escolhe sozinho o modelo de imagem mais recente disponível para a key.
GEMINI_IMAGE_MODEL=
GEMINI_DELAY_MS=13000
# Opcional: chave de um projeto Google SEM faturamento, só para as traduções (custo zero).
GEMINI_FREE_API_KEY=

# Worker da Cloudflare. INGEST_TOKEN tem que ser igual ao secret do worker
# (`wrangler secret put INGEST_TOKEN`).
WORKER_URL=https://hooke-news.yelnalts1993.workers.dev
INGEST_TOKEN=

# Bucket do site (as imagens ficam em img/noticias/). Na EC2, prefira uma IAM role
# com s3:PutObject nesse prefixo; fora dela, use AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
S3_BUCKET=
S3_REGION=sa-east-1
S3_PREFIX=img/noticias/

# Volume por execução
MAX_PER_SECTOR=1
MAX_PER_RUN=10
MAX_ITEM_AGE_DAYS=7
